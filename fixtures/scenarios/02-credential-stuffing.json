{
  "id": "credential-stuffing",
  "name": "Credential Stuffing",
  "summary": "Leaked credential pairs are replayed against the login endpoint. Almost all fail; the few that succeed are stopped by policy.",
  "category": "identity",
  "severity": "warning",
  "durationMs": 84000,
  "rootCause": "role:primaryAuth",
  "targets": [
    "role:primaryAuth",
    "role:primaryGateway",
    "role:attackSource"
  ],
  "flows": [
    {
      "id": "stuffing",
      "label": "Replayed credentials",
      "suspicious": true,
      "hops": [
        {
          "from": "role:attackSource",
          "to": "role:edgeRouter"
        },
        {
          "from": "role:edgeRouter",
          "to": "role:primaryGateway"
        },
        {
          "from": "role:primaryGateway",
          "to": "role:primaryAuth"
        },
        {
          "from": "role:primaryGateway",
          "to": "role:primaryAuthorizer"
        }
      ],
      "spill": false,
      "authz": {
        "request": "stolen-session-export",
        "authorizer": "role:primaryAuthorizer"
      }
    }
  ],
  "phases": [
    {
      "name": "Low and slow",
      "atMs": 0,
      "rampMs": 3000,
      "status": "active",
      "description": "A trickle of login attempts tests which leaked credentials are still valid.",
      "effects": [
        {
          "type": "flowRate",
          "flow": "stuffing",
          "rate": {
            "ofCapacity": {
              "node": "role:primaryAuth",
              "factor": 0.06
            }
          }
        },
        {
          "type": "flowReject",
          "flow": "stuffing",
          "at": "role:primaryAuth",
          "fraction": 0.985,
          "reason": "auth-failure"
        }
      ],
      "events": [
        {
          "delayMs": 3000,
          "severity": "notice",
          "kind": "auth-failure",
          "title": "Authentication failures rising",
          "message": "Failed logins are spread thinly across many accounts.",
          "nodes": [
            "role:primaryAuth"
          ]
        }
      ]
    },
    {
      "name": "Stuffing burst",
      "atMs": 10000,
      "rampMs": 6000,
      "status": "active",
      "description": "Login attempts surge past the identity service's capacity. Legitimate sign-ins start to fail.",
      "effects": [
        {
          "type": "flowRate",
          "flow": "stuffing",
          "rate": {
            "ofCapacity": {
              "node": "role:primaryAuth",
              "factor": 1.25
            }
          }
        },
        {
          "type": "flowReject",
          "flow": "stuffing",
          "at": "role:primaryAuth",
          "fraction": 0.985,
          "reason": "auth-failure"
        }
      ],
      "events": [
        {
          "delayMs": 6000,
          "severity": "critical",
          "kind": "alert",
          "title": "Credential stuffing pattern detected",
          "message": "More than 98 % of login attempts from unattributed sources fail, across thousands of distinct accounts.",
          "nodes": [
            "role:securityMonitor",
            "role:primaryAuth"
          ]
        },
        {
          "delayMs": 10000,
          "severity": "warning",
          "kind": "auth-failure",
          "title": "Valid credentials replayed without MFA",
          "message": "A small share of attempts authenticate, but the sessions carry no MFA assertion.",
          "nodes": [
            "role:primaryAuth",
            "role:primaryAuthorizer"
          ]
        }
      ]
    },
    {
      "name": "Adaptive rate limiting",
      "atMs": 30000,
      "rampMs": 5000,
      "status": "mitigating",
      "description": "The gateway throttles login attempts per source, relieving the identity service.",
      "effects": [
        {
          "type": "flowRate",
          "flow": "stuffing",
          "rate": {
            "ofCapacity": {
              "node": "role:primaryAuth",
              "factor": 1.25
            }
          }
        },
        {
          "type": "flowReject",
          "flow": "stuffing",
          "at": "role:primaryGateway",
          "fraction": 0.92,
          "reason": "rate-limit"
        },
        {
          "type": "flowReject",
          "flow": "stuffing",
          "at": "role:primaryAuth",
          "fraction": 0.985,
          "reason": "auth-failure"
        }
      ],
      "events": [
        {
          "delayMs": 0,
          "severity": "notice",
          "kind": "mitigation",
          "title": "Login rate limiting engaged",
          "message": "The API gateway now answers excess login attempts with HTTP 429.",
          "nodes": [
            "role:primaryGateway"
          ]
        }
      ]
    },
    {
      "name": "Source blocked",
      "atMs": 50000,
      "rampMs": 4000,
      "status": "mitigating",
      "description": "The offending sources are blocked at the edge.",
      "effects": [
        {
          "type": "flowRate",
          "flow": "stuffing",
          "rate": {
            "ofCapacity": {
              "node": "role:primaryAuth",
              "factor": 0.9
            }
          }
        },
        {
          "type": "flowReject",
          "flow": "stuffing",
          "at": "role:edgeRouter",
          "fraction": 0.99,
          "reason": "waf"
        },
        {
          "type": "flowReject",
          "flow": "stuffing",
          "at": "role:primaryGateway",
          "fraction": 0.92,
          "reason": "rate-limit"
        },
        {
          "type": "flowReject",
          "flow": "stuffing",
          "at": "role:primaryAuth",
          "fraction": 0.985,
          "reason": "auth-failure"
        }
      ],
      "events": [
        {
          "delayMs": 0,
          "severity": "notice",
          "kind": "mitigation",
          "title": "Sources blocked at the edge",
          "message": "Reputation rules reject the attacking sources at the edge router.",
          "nodes": [
            "role:edgeRouter"
          ]
        }
      ]
    },
    {
      "name": "Recovery",
      "atMs": 68000,
      "rampMs": 6000,
      "status": "recovering",
      "description": "Attempts stop and authentication returns to normal.",
      "effects": [],
      "events": [
        {
          "delayMs": 8000,
          "severity": "info",
          "kind": "mitigation",
          "title": "Authentication back to baseline",
          "message": "Login failure rate is back in its normal range.",
          "nodes": [
            "role:primaryAuth"
          ]
        }
      ]
    }
  ]
}
