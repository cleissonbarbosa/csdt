{
  "$id": "https://raw.githubusercontent.com/cleissonbarbosa/csdt/main/schemas/v1/topology.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TopologySpec",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "dataSource": {
      "enum": [
        "synthetic"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/DataSource"
        }
      ]
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Region"
      }
    },
    "roles": {
      "description": "Named anchors scenarios use to stay topology independent.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NodeSpec"
      },
      "minItems": 1,
      "maxItems": 2000
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EdgeSpec"
      },
      "maxItems": 20000
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "dataSource",
    "regions",
    "nodes",
    "edges"
  ],
  "definitions": {
    "DataSource": {
      "description": "Provenance of a piece of data. AEGIS never presents one as another.",
      "oneOf": [
        {
          "description": "Produced by the internal simulation engine.",
          "type": "string",
          "const": "synthetic"
        },
        {
          "description": "Imported from a prerecorded or hand-authored fixture file.",
          "type": "string",
          "const": "recording"
        },
        {
          "description": "Measured from an explicitly connected local instance.",
          "type": "string",
          "const": "live"
        }
      ]
    },
    "Region": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/RegionKind"
        },
        "location": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "location"
      ]
    },
    "RegionKind": {
      "type": "string",
      "enum": [
        "edge",
        "cloud"
      ]
    },
    "NodeSpec": {
      "description": "Static description of a node as authored in a topology fixture.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/ServiceType"
        },
        "region": {
          "type": "string"
        },
        "tier": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "environment": {
          "default": "demo",
          "allOf": [
            {
              "$ref": "#/definitions/Environment"
            }
          ]
        },
        "baseLatencyMs": {
          "type": "number",
          "format": "double",
          "minimum": 0
        },
        "capacityRps": {
          "description": "Explicit capacity. When absent it is derived from `headroom`.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "exclusiveMinimum": 0,
          "default": null
        },
        "headroom": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "exclusiveMinimum": 1,
          "default": null
        },
        "baseRps": {
          "description": "Demand generated by an external client at nominal load.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "region",
        "tier",
        "baseLatencyMs"
      ]
    },
    "ServiceType": {
      "type": "string",
      "enum": [
        "api-gateway",
        "auth-service",
        "cedar-authorizer",
        "microservice",
        "container",
        "serverless",
        "message-queue",
        "database",
        "storage",
        "network-gateway",
        "security-monitor",
        "external-client"
      ]
    },
    "Environment": {
      "type": "string",
      "enum": [
        "production",
        "staging",
        "demo"
      ]
    },
    "EdgeSpec": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/definitions/Protocol"
        },
        "relationship": {
          "$ref": "#/definitions/Relationship"
        },
        "weight": {
          "description": "Calls issued on this edge per request handled by the source.",
          "type": "number",
          "format": "double",
          "minimum": 0
        },
        "criticality": {
          "description": "How strongly a failure of the target fails the caller (0..1).",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0,
          "maximum": 1,
          "default": null
        },
        "latencyMs": {
          "description": "Network latency of the hop. Derived from region placement when absent.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "protocol",
        "relationship",
        "weight"
      ]
    },
    "Protocol": {
      "type": "string",
      "enum": [
        "https",
        "grpc",
        "amqp",
        "sql",
        "redis",
        "s3",
        "tcp",
        "otlp"
      ]
    },
    "Relationship": {
      "oneOf": [
        {
          "description": "Load-balanced routing: each request goes to exactly one target.",
          "type": "string",
          "const": "route"
        },
        {
          "description": "Synchronous service dependency.",
          "type": "string",
          "const": "call"
        },
        {
          "description": "Authentication check.",
          "type": "string",
          "const": "auth"
        },
        {
          "description": "Authorization (policy decision) check.",
          "type": "string",
          "const": "authz"
        },
        {
          "description": "Synchronous read/write against a data store.",
          "type": "string",
          "const": "data"
        },
        {
          "description": "Asynchronous publish into a queue.",
          "type": "string",
          "const": "publish"
        },
        {
          "description": "Asynchronous consumption from a queue.",
          "type": "string",
          "const": "consume"
        },
        {
          "description": "Asynchronous replication between stores.",
          "type": "string",
          "const": "replication"
        },
        {
          "description": "Asynchronous telemetry export.",
          "type": "string",
          "const": "telemetry"
        }
      ]
    }
  }
}
