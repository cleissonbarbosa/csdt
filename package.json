{
  "name": "aegis",
  "version": "0.3.1",
  "private": true,
  "description": "AEGIS — Interactive Cloud Security Digital Twin",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @aegis/web --filter @aegis/contracts run dev",
    "dev:web": "pnpm --filter @aegis/web run dev",
    "dev:server": "cargo run -p aegis-server",
    "build": "pnpm --filter @aegis/contracts run build && pnpm --filter @aegis/web run build",
    "engine:build": "./scripts/build-engine.sh",
    "build:static": "pnpm engine:build && pnpm --filter @aegis/web run build:static",
    "dev:static": "pnpm --filter @aegis/web run dev:static",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "test": "pnpm -r run test",
    "test:rust": "cargo test --workspace",
    "test:engine": "pnpm --filter @aegis/web run test:engine",
    "e2e": "pnpm --filter @aegis/web run e2e",
    "e2e:static": "pnpm --filter @aegis/web run e2e:static",
    "contracts:samples": "cargo run -q -p aegis-server --bin export-contract-samples",
    "workspace:schemas": "cargo run -q -p aegis-server --bin export-workspace-schemas"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
