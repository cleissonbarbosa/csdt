# AEGIS configuration. Every value is optional: Demo Mode needs none of them.
# Copy to `.env` (git-ignored) to override. Never commit real tokens.

# --- Server -----------------------------------------------------------------
# Address the Rust backend binds to.
AEGIS_BIND=127.0.0.1:8787
# Comma-separated list of browser origins allowed by CORS.
AEGIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Seed for the deterministic simulation engine.
AEGIS_SEED=42
# Log filter (tracing-subscriber EnvFilter syntax).
AEGIS_LOG=info

# --- Workspace (opt-in) -----------------------------------------------------
# Directory with your own topologies, scenarios, recordings and Cedar policies.
# Read once at start-up; what it holds replaces the bundled files, the rest
# stays. `aegis-server export-workspace <dir>` writes a starting point and
# `aegis-server check-workspace <dir>` validates one. See docs/WORKSPACE.md.
AEGIS_WORKSPACE=
# Whether the interface may replace those files while the server runs. On by
# default; an import is checked first, held in memory and undone by a restart.
# There is one simulation and no authentication, so whoever can reach the API
# can replace what everyone sees: set this to off on a server others share.
AEGIS_IMPORT=on

# --- Connected Mode (opt-in) ------------------------------------------------
# Nothing below is contacted unless it is set AND you press "Connect" in the UI.
# Only loopback targets are accepted unless the host is listed in
# AEGIS_INTEGRATION_ALLOWED_HOSTS (e.g. a docker-compose service name).

# Local instance of github.com/cleissonbarbosa/cedar-agent (default port 8180).
AEGIS_CEDAR_AGENT_URL=
# Optional token the agent was started with (--authentication). Stays server-side.
AEGIS_CEDAR_AGENT_TOKEN=
# When true, "Connect" also uploads the policies and entities AEGIS evaluates
# (the synthetic ones, or a workspace's) to the agent (PUT /v1/policies,
# PUT /v1/data). This REPLACES the agent's stores.
AEGIS_CEDAR_AGENT_SYNC=false

# Local instance of github.com/cleissonbarbosa/rinha-backend-2026 (default port 9999).
# AEGIS only issues read-only `GET /ready` probes, at most one per second.
AEGIS_RINHA_URL=

# Extra hostnames (comma-separated) allowed as integration targets.
AEGIS_INTEGRATION_ALLOWED_HOSTS=

# --- Web (build time) -------------------------------------------------------
# Base URL of the AEGIS API as seen from the browser. Empty = same origin.
VITE_AEGIS_API_URL=
